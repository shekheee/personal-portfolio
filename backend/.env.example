# ── Backend environment ──────────────────────────────────────────────────────
# Copy to backend/.env and fill in values. Only the LLM key is required for chat.

ENVIRONMENT=production

# LLM — Anthropic Fable 5 is primary; OpenAI GPT-5.6 and Groq are fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Contact form email (optional — Gmail example, use an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# GitHub section (token optional; enables the contribution heatmap).
GITHUB_TOKEN=
GITHUB_USERNAME=shekheee

# CORS — comma-separated allowed origins (your site's URL).
ALLOWED_ORIGINS=http://localhost:3000,https://ajayshekhawat.uk,https://www.ajayshekhawat.uk
