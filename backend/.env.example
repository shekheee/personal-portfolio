# ── Backend environment ──────────────────────────────────────────────────────
# Copy to backend/.env and fill in values. Only the LLM key is required for chat.

ENVIRONMENT=production

# LLM — Groq is free and preferred (get a key at https://console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI fallback (used only if GROQ_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Contact form email (optional — Gmail example, use an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# GitHub section (token optional; enables the contribution heatmap).
GITHUB_TOKEN=
GITHUB_USERNAME=shekheee

# CORS — comma-separated allowed origins (your site's URL).
ALLOWED_ORIGINS=http://localhost:3000,https://ajayshekhawat.co.uk,https://www.ajayshekhawat.co.uk
