# ── Environment overview ─────────────────────────────────────────────────────
# This project deploys as two pieces (no Docker needed):
#   - frontend/  → Next.js app (host on Vercel)
#   - backend/   → FastAPI app (host on Render)
#
# Backend env vars: see backend/.env.example
# Frontend env var (set in Vercel):
#   NEXT_PUBLIC_BACKEND_URL=https://api.ajayshekhawat.co.uk
